# Хост, на котором Caddy будет отдавать сайт (например, imb.example.ru).
SITE_HOST=example.com

# E-mail для ACME / Let's Encrypt уведомлений.
ACME_EMAIL=admin@example.com

# Gmail-аккаунт и App Password для отправки заявок с формы.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Куда слать заявки (по умолчанию business@prosebya.ru).
LEAD_MAIL_TO=business@prosebya.ru
